// Shared build settings for every captAI target.
// Optional per-developer overrides (signing team) live in Local.xcconfig, which is gitignored.

MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES

// Default: ad-hoc signing so a fresh checkout builds with no Apple account.
// Screen Recording permission is tied to the code signature, so ad-hoc builds may need the
// permission re-granted after rebuilds. Copy Local.xcconfig.example to Local.xcconfig to use a stable identity.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -

#include? "Local.xcconfig"
