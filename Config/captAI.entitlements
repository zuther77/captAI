<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Screen Recording is a TCC permission, not an entitlement. Microphone input requires this
	     entitlement under the hardened runtime (Release). The App Sandbox decision is D-003. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
